# Copy to .env and adjust. Every value here is optional; these are the defaults.

PORT=3001

# Comma-separated list of front-end origins allowed to call the API. "*" allows any.
CORS_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (nginx, Render, Fly…) so
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=false

# DANGER: lets the scanner open localhost / LAN addresses. Local testing only.
ALLOW_PRIVATE_HOSTS=false

# Needed inside most Docker containers, where Chrome's sandbox cannot start.
CHROME_NO_SANDBOX=false

MAX_CONCURRENT_SCANS=2
MAX_QUEUED_SCANS=10
SCAN_TIMEOUT_MS=60000
NAVIGATION_TIMEOUT_MS=30000
MAX_SCROLL_STEPS=40
STABLE_STEPS_TO_STOP=2
SCROLL_DELAY_MS=700
MAX_MATCHES=500

MAX_URL_LENGTH=2048
MAX_KEYWORD_LENGTH=100

# Scans allowed per IP per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

SSE_HEARTBEAT_MS=15000
